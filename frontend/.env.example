# Use mock data when no API is available (default: true for dev)
VITE_USE_MOCK=true
# Base URL for backend (empty = same origin; in dev Vite proxies /api to localhost:8080)
VITE_API_BASE=

# Username бота без @ (для Telegram Login Widget; пусто = кнопка входа скрыта)
VITE_TG_BOT_NAME=
# Числовой ID бота — цифры до «:» в токене. Если задан, вместо iframe-виджета
# рисуется своя кнопка в стиле проекта (Telegram.Login.auth).
VITE_TG_BOT_ID=
